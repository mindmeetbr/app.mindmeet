{
  "name": "mindmeet-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "biome:fix": "biome check --write",
    "biome:fix-staged": "biome check --write --staged",
    "serve:preview": "vite preview",
    "test:unit": "vitest",
    "types:validate": "tsc --noEmit",
    "validate:all": "tsc --noEmit && vite build && npm run biome:fix",
    "generate:orval-client": "orval",
    "generate:client-and-validate": "npm run generate:orval-client && npm run types:validate"
  },
  "dependencies": {
    "@mantine/core": "^8.2.2",
    "@mantine/dates": "^8.2.2",
    "@mantine/form": "^8.2.2",
    "@mantine/hooks": "^8.2.2",
    "@mantine/notifications": "^8.2.2",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-router": "^1.130.12",
    "@tanstack/react-router-devtools": "^1.130.13",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "jwt-decode": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.14",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@eslint/js": "^9.30.1",
    "@tanstack/router-plugin": "^1.130.12",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "orval": "^7.11.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
